ARG BASE_IMAGE=ghcr.io/tpurtell/glm-5.3-flash-exl3-4bpw-2x-rtx:v0.6.0@sha256:fe249b88d091430d8a88cd987d087d556053f0f067a649f2e9ca95895129e82b
FROM ${BASE_IMAGE}
COPY pyproject.toml README.md LICENSE /opt/parallelhue/
COPY src /opt/parallelhue/src
RUN mkdir -p /opt/parallelhue/build-tmp \
    && TMPDIR=/opt/parallelhue/build-tmp python3 -m pip install --no-cache-dir --no-deps --no-build-isolation /opt/parallelhue \
    && rm -rf /opt/parallelhue/build-tmp
